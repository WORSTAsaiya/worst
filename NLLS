	-- ---------------------------------------------------------------- sell: dropdown + Auto Sell
	local SELL_EVERY = {
		["Instant"] = 0.1, ["Half Second"] = 0.6, ["Every 1 Second"] = 1, ["Every 3 Seconds"] = 3, ["Every 5 Seconds"] = 5,
		["Every 10 Seconds"] = 10, ["Every 15 Seconds"] = 15, ["Every 30 Seconds"] = 30, ["Every 60 Seconds"] = 60,
		["Every 5 Minutes"] = 300, ["Every 1 Hour"] = 3600,
	}
	local sellChoice = "Every 3 Seconds"
	local sellIsFull = false
	local sellToggle

	-- ---------------------------------------------------------------- reading cash / storage / shop prices from the game's own HUD
	-- cash        : PlayerGui.Main_Gui.DataMenu_Frame.Cash.Status.Text      ("39.34M")
	-- storage     : PlayerGui.Main_Gui.DataMenu_Frame.Muscle.Status.Text    ("3.9M/5M" = muscle / storage size)
	-- weight price: PlayerGui.Main_Gui.UpgradeInfo_Frame.PageList.<page>.<weight>.tlPrice   ("Owned" once you have it)
	local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }
	local function parseNumber(text)
		if type(text) ~= "string" then return nil end
		local s = (text:gsub("[%$,%s]", ""))
		local num, suf = s:match("^(%d*%.?%d+)(%a*)$")
		if not num then return nil end
		local mult = 1
		if suf ~= "" then
			mult = SUFFIX[suf:lower()]
			if not mult then return nil end
		end
		return tonumber(num) * mult
	end
	local FMT_UNITS = { { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
	local function fmtNum(n)
		for _, u in ipairs(FMT_UNITS) do
			if n >= u[1] then return string.format("%.2f%s", n / u[1], u[2]) end
		end
		return tostring(math.floor(n))
	end
	local function readCash()
		local ok, t = pcall(function() return player.PlayerGui.Main_Gui.DataMenu_Frame.Cash.Status.Text end)
		return ok and parseNumber(t) or nil
	end
	local function readStorageSize()
		local ok, t = pcall(function() return player.PlayerGui.Main_Gui.DataMenu_Frame.Muscle.Status.Text end)
		if not ok or type(t) ~= "string" then return nil end
		return parseNumber(t:match("/%s*(.+)$"))
	end
	-- the next weight you don't own (same one Auto buy Weight goes for) and its price from the shop screen
	local function readNextWeight()
		local idx = highestOwned() + 1
		while WEIGHT_ORDER[idx] == "Unavailable" do idx = idx + 1 end
		local nm = WEIGHT_ORDER[idx]
		if not nm then return nil, nil end
		local ok, price = pcall(function()
			local list = player.PlayerGui.Main_Gui.UpgradeInfo_Frame.PageList
			local item = list:FindFirstChild(nm, true)
			local tl = item and item:FindFirstChild("tlPrice")
			return tl and parseNumber(tl.Text)
		end)
		return nm, ok and price or nil
	end

	-- ---------------------------------------------------------------- "Sell If Enough": sells when your cash + what the muscle sells for just covers the next weight
	local SELL_ENOUGH = "Sell If Enough"
	local sellRate = 0.9            -- cash per muscle sold (your own test: ~0.92); re-learned after every sale
	local keptMuscle = 200000       -- muscle that stayed after your test sale; re-learned after every sale
	local ENOUGH_MARGIN = 1.02      -- needs 2% more than the price, so a small error in the estimate doesn't waste a sale
	local FULL_AT = 0.98            -- storage this full = sell anyway, so lifting is never wasted
	local function startSellEnough()
		env.Sell = true
		local my = newGen("sell")
		task.spawn(function()
			local lastSale = 0
			while env.Sell and gens.sell == my do
				local ls = player:FindFirstChild("leaderstats")
				local mv = ls and ls:FindFirstChild("Muscle")
				local muscle, cash = mv and mv.Value, readCash()
				if not (muscle and cash) then
					Status.set("sell", "Waiting - can't read your muscle / cash yet")
				else
					local size = readStorageSize()
					local nm, price = readNextWeight()
					local sellable = math.max(muscle - keptMuscle, 0)
					local reason
					if size and muscle >= size * FULL_AT then
						reason = "storage full"
					elseif price and cash < price and cash + sellable * sellRate >= price * ENOUGH_MARGIN then
						reason = "enough for " .. tostring(nm)
					end
					if not nm then
						Status.set("sell", "All weights owned - selling when the storage is full")
					elseif not price then
						Status.set("sell", "Waiting - can't read the price of " .. nm .. " (selling when the storage is full)")
					elseif cash >= price then
						Status.set("sell", "Enough cash for " .. nm .. " - waiting for it to be bought")
					else
						Status.set("sell", ("%s costs %s - cash %s + muscle %s"):format(nm, fmtNum(price), fmtNum(cash), fmtNum(sellable * sellRate)))
					end
					if reason and os.clock() - lastSale > 3 then
						Status.set("sell", "Selling (" .. reason .. ")")
						local owned0 = highestOwned()
						fire("SellMuscle")
						lastSale = os.clock()
						task.wait(0.8)
						if gens.sell ~= my then break end
						-- learn from this sale (skipped when a weight got bought in the meantime)
						local muscle2, cash2 = mv.Value, readCash()
						if cash2 and highestOwned() == owned0 then
							local sold = muscle - muscle2
							if sold > 0 and cash2 > cash then
								local r = (cash2 - cash) / sold
								if r > 0.05 and r < 5 then sellRate = sellRate * 0.5 + r * 0.5 end
								keptMuscle = math.clamp(keptMuscle * 0.5 + muscle2 * 0.5, 0, muscle * 0.5)
							end
						end
					end
				end
				task.wait(0.5)
			end
		end)
	end

	local function stopSell()
		env.Sell = false
		newGen("sell")
		newGen("sellfull")
		Status.set("sell", nil)
		Status.set("sellfull", nil)
