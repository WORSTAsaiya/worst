		["Divinities"] = CFrame.new(27536.45, 94.01, 1815.89),
		["Egyptians"] = CFrame.new(30026.91, 94.01, 1872.04),
		["Hollowed"] = CFrame.new(32671.49, 94.01, 1852.79),
		["Trial"] = CFrame.new(35397.16, 94.01, 1898.30),
	}

	local function getRoot()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end

	-- the Foot tool: equips it so the stomps (M1) hit
	local function isFoot(item) return item:IsA("Tool") and item.Name:lower():find("foot") ~= nil end
	local function equipFoot()
		local ch, bp = player.Character, player:FindFirstChild("Backpack")
		local hum = ch and ch:FindFirstChildOfClass("Humanoid")
		if not (hum and bp) then return end
		for _, item in ipairs(ch:GetChildren()) do
			if isFoot(item) then return end   -- already in the hand
		end
		for _, item in ipairs(bp:GetChildren()) do
			if isFoot(item) then hum:EquipTool(item) return end
		end
	end

	local function clickM1()
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
		task.wait(0.1)
		VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
	end

	-- ---------------------------------------------------------------- Auto Kill
	local bloodlineChoice = BLOODLINE_NAMES[1]
	local killToggle
	local killGen = 0

	-- waits `sec` seconds but stops early when the toggle is switched off / changed; returns false if it was stopped
	local function sleepWhileKilling(sec, my)
		local t0 = os.clock()
		while alive and killGen == my and os.clock() - t0 < sec do task.wait(0.1) end
		return alive and killGen == my
	end

	local function stopKill()
		killGen += 1
		Status.set("kill", nil)
	end

	local function startKill()
		killGen += 1
		local my = killGen
		local name = bloodlineChoice
		local spots = SPOTS[name] or {}
		Status.set("kill", ("%s - starting..."):format(name))
		task.spawn(function()
			while alive and killGen == my do
				if not getRoot() then
					Status.set("kill", "Waiting for your character to respawn")
					task.wait(0.5)
				else
					equipFoot()
					for i, cf in ipairs(spots) do
						local root = getRoot()
						if not (alive and killGen == my and root) then break end
						Status.set("kill", ("%s - stomping at spot %d/%d"):format(name, i, #spots))
						root.CFrame = cf
						clickM1()
						if not sleepWhileKilling(3, my) then break end
					end
				end
			end
		end)
	end

	-- ---------------------------------------------------------------- Teleport to Island
	local islandChoice = BLOODLINE_NAMES[1]

	local function tweenToPosition(cframe, duration)
		local root = getRoot()
		if not root then return false end
		local tw = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), { CFrame = cframe })
		tw:Play()
		tw.Completed:Wait()
		return true
	end

	local entries = {}

	entries[#entries + 1] = {
		type = "dropdown", name = "Choose Bloodline", icon = "⚔", width = 260,
		desc = "Which bloodline island Auto Kill farms (Hercules to Trial).",
		options = BLOODLINE_NAMES, default = bloodlineChoice,
		callback = function(option)
			if option == nil then return end
			bloodlineChoice = option
			if killToggle and killToggle._get and killToggle._get() then startKill() end   -- switch bloodline while running
		end,
	}

	killToggle = {
		type = "toggle", name = "Auto Kill", icon = "☠", default = false,
		desc = "Teleports to the kill spots of the chosen bloodline and stomps them with the Foot. Equip your Foot first.",
		callback = function(on)
			if on then startKill() else stopKill() end
		end,
	}
	entries[#entries + 1] = killToggle

	entries[#entries + 1] = {
		type = "dropdown", name = "Choose Island", icon = "🏝", width = 260,
		desc = "Which island the Teleport button takes you to (Hercules to Trial).",
		options = BLOODLINE_NAMES, default = islandChoice,
		callback = function(option)
			if option == nil then return end
			islandChoice = option
		end,
	}

	entries[#entries + 1] = {
		type = "button", name = "Teleport to Island", icon = "🚀", btnText = "Teleport", noSave = true,
		desc = "Teleports you to the island chosen above.",
		run = function()
			local cf = ISLAND_CFRAMES[islandChoice]
			if not cf then error("Pick an island first") end
			Status.set("tp", "Going to " .. islandChoice)
			local ok, moved = pcall(tweenToPosition, cf, 0.8)
			Status.set("tp", nil)
			if not ok or not moved then error("Your character isn't loaded") end
			return true
		end,
	}

	return entries
end)()
