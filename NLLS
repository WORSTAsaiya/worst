	-- ---------------------------------------------------------------- the rest
	local rest = {
		{
			type = "toggle", name = "Gain Muscle + Sell If Full Storage (Normal Speed)", icon = "💪", default = false,
			desc = "Gains muscle every 0.7s and sells when your storage stops filling.",
