		sellIsFull = false
	end
	local function startSell()
		stopSell()
		if sellChoice == "Sell If Full" then
			sellIsFull = true
			gainAndSell(true, 15, "sellfull")
			return
		end
		if sellChoice == SELL_ENOUGH then startSellEnough() return end
		local interval = SELL_EVERY[sellChoice]
		if not interval then return end
		env.Sell = true
		local my = newGen("sell")
		task.spawn(function()
			local last = tick()
			while env.Sell and gens.sell == my do
				local left = interval - (tick() - last)
				if left <= 0 then
					fire("SellMuscle")
					last = tick()
					left = interval
				end
				if interval < 2 then
					Status.set("sell", "Selling constantly (" .. tostring(sellChoice) .. ")")
				else
					Status.set("sell", "Waiting for the next sale", left)
				end
				task.wait(0.1)
			end
		end)
	end

