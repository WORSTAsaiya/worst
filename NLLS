-- Calls fn safely (an error in it never breaks the hub).
local function safe(fn, ...)
	if typeof(fn) ~= "function" then return true end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[WORST Hub] error: " .. tostring(err)) end
	return ok, err
end

