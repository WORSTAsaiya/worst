		},
		{
			type = "toggle", name = "Gain Muscle + Sell If Full Storage (Fast Lifter Gamepass)", icon = "💪", default = false,
			desc = "Gains muscle every 0.45s and sells when your storage stops filling.",
			callback = function(on) gainAndSell(on == true, 0.45, "gs2") end,
		},
		{
			type = "toggle", name = "Auto buy Weight", icon = "🏋", default = false,
			desc = "Buys the next weight you don't have yet, in order.",
			callback = function(on)
				env.BuyWeight = on == true
				if not on then Status.set("weight", nil) return end
				local my = newGen("buyweight")
				Status.set("weight", "Checking your weights...")
				task.spawn(function()
					while env.BuyWeight and gens.buyweight == my do
						if player:FindFirstChild("Backpack") then
							-- find the highest weight you own, then buy the one after it
							local highest = highestOwned()
							local nextIndex = highest + 1
							while WEIGHT_ORDER[nextIndex] == "Unavailable" do nextIndex = nextIndex + 1 end
							if nextIndex > #WEIGHT_ORDER then
								print("Player has all weights!")
								Status.set("weight", "Waiting - all weights owned")
								return
							end
							local nm = WEIGHT_ORDER[nextIndex]
							print("Attempting to buy weight index: ", nextIndex)
							Status.set("weight", "Buying " .. nm)
							fire("BuyItem", "Income_Item", "Weight", nextIndex)
							task.wait(1)
							if not env.BuyWeight or gens.buyweight ~= my then break end
							if highestOwned() > highest then
								Status.set("weight", "Bought " .. nm)
							else
								Status.set("weight", "Waiting for enough coins for " .. nm)
							end
						else
							task.wait(1)
						end
					end
					if gens.buyweight == my then Status.set("weight", nil) end
				end)
			end,
		},
		{
			type = "toggle", name = "Auto Body Alter", icon = "🔁", default = false,
			desc = "Auto buy new Body Alter (Stage).",
			callback = function(on)
				env.BuyAlter = on == true
