						for i = 1, 30 do
							if not env.BuyAlter or gens.alter ~= my then break end
							fire("BuyItem", "Rebirth_Item", "Rebirth1", i)
							task.wait(0.1)
						end
						task.wait(1)
						if not env.BuyAlter or gens.alter ~= my then break end
						local after = stageValue()
						if before and after and after > before then
							Status.set("alter", "Bought stage " .. after)
						else
							Status.set("alter", "Waiting for enough coins")
						end
						task.wait(4)
					end
					if gens.alter == my then Status.set("alter", nil) end
				end)
			end,
		},
		{
			type = "toggle", name = "Smart Weight", icon = "🧠", default = false,
			desc = "Only buys the weights you need to reach the next stage (saves coins).",
			callback = function(on)
				env.BuyWeight = on == true
				if not on then Status.set("sweight", nil) return end
				local my = newGen("smartweight")
				task.spawn(function()
					while env.BuyWeight and gens.smartweight == my do
						local stage = stageValue()
						if not stage then
							warn("Stage not found in leaderstats!")
							Status.set("sweight", "Can't read your stage")
							return
						end
						local maxWeight = maxFor(WEIGHT_BY_STAGE, 21, 144, stage)
						local before = highestOwned()
						if before >= maxWeight then
							Status.set("sweight", ("Waiting for the next stage (weights up to #%d owned)"):format(maxWeight))
							task.wait(1)
						else
							Status.set("sweight", ("Buying weights up to #%d (stage %d)"):format(maxWeight, stage))
							for i = 2, maxWeight do
								if not env.BuyWeight or gens.smartweight ~= my then return end
								fire("BuyItem", "Income_Item", "Weight", i)
								task.wait(0.1)
							end
							task.wait(0.5)
							if not env.BuyWeight or gens.smartweight ~= my then break end
							local after = highestOwned()
							if after > before then
								Status.set("sweight", "Bought up to " .. WEIGHT_ORDER[after])
							elseif after < maxWeight then
								local nxt = after + 1
								if WEIGHT_ORDER[nxt] == "Unavailable" then nxt = nxt + 1 end
								Status.set("sweight", "Waiting for enough coins for " .. tostring(WEIGHT_ORDER[nxt] or "the next weight"))
							end
							task.wait(1)
						end
					end
					if gens.smartweight == my then Status.set("sweight", nil) end
				end)
			end,
		},
		{
			type = "toggle", name = "Smart DNA", icon = "🧬", default = false,
			desc = "Only buys the DNA you need to reach the next stage (saves coins).",
			callback = function(on)
				env.BuyDNA = on == true
				if not on then Status.set("dna", nil) return end
				local my = newGen("smartdna")
				task.spawn(function()
					while env.BuyDNA and gens.smartdna == my do
						local stage = stageValue() or 0
						local maxDNA = maxFor(DNA_BY_STAGE, 12, 70, stage)
						Status.set("dna", ("Buying DNA up to #%d (stage %d)"):format(maxDNA, stage))
						for i = 1, maxDNA do
							if not env.BuyDNA or gens.smartdna ~= my then return end
							fire("BuyItem", "Bag_Item", "DNA name", i)
							task.wait(0.1)
						end
						task.wait(1)
					end
					if gens.smartdna == my then Status.set("dna", nil) end
				end)
			end,
		},
	}
	for _, e in ipairs(rest) do entries[#entries + 1] = e end
	return entries
end)()

