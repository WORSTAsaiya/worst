-- Webhook URL box + Enable Webhook Logger toggle. While it is on, your username, muscle, stage and cash are posted to the webhook
-- right away and then every 10 minutes (same message as the old script).
TAB_SCRIPTS.Webhook = (function()
	local Status = FX.Status
	local SEND_EVERY = 600
	local webhookURL = ""
	local loggerToggle
	local gen = 0

	-- 1.2K / 1.20M / 1.20B
	local function formatBigNumber(num)
		if num >= 1e9 then return string.format("%.2fB", num / 1e9)
		elseif num >= 1e6 then return string.format("%.2fM", num / 1e6)
		elseif num >= 1e3 then return string.format("%.2fK", num / 1e3)
		end
		return tostring(num)
	end

	-- the executor's HTTP request function (nil when it has none)
	local function getHttpFunction()
		return (syn and syn.request) or http_request or request or (fluxus and fluxus.request) or nil
	end

	-- posts the stats to the webhook; returns true when it was sent
	local function sendStats()
		local http = getHttpFunction()
		if not (http and webhookURL ~= "") then return false end

		local ls = player:FindFirstChild("leaderstats")
		local muscleV, stageV = ls and ls:FindFirstChild("Muscle"), ls and ls:FindFirstChild("Stage")
		local muscle = muscleV and muscleV.Value or 0
		local stage = stageV and stageV.Value or 0
		local cashText = "N/A"
		pcall(function() cashText = player.PlayerGui.Main_Gui.DataMenu_Frame.Cash.Status.Text end)
		local displayCash = (tostring(cashText):gsub("0%.00%s*", ""))
		local muscleDisplay = (muscle == 0) and "Concealed :lock:" or formatBigNumber(muscle)

		local data = {
			["content"] = "**:bust_in_silhouette: Username:** " .. player.Name ..
				"\n**:muscle: Muscle Stat:** " .. muscleDisplay ..
				"\n**:cyclone: Stage:** " .. stage ..
				"\n**:moneybag: Cash:** " .. displayCash,
			["username"] = "Stat Logger",
			["avatar_url"] = "https://cdn.discordapp.com/attachments/1350798224197160982/1359693324813996072/Azuma_Logo.png",
		}
		local ok, err = pcall(http, {
			Url = webhookURL, Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode(data),
		})
		if not ok then
			warn("Failed to send webhook:", err)
			return false
		end
		print("Webhook sent successfully!")
		return true
	end

	local function stop()
		gen += 1
		Status.set("webhook", nil)
	end

	local function start()
		gen += 1
		local my = gen
		task.spawn(function()
			local function live() return alive and gen == my end
			if not getHttpFunction() then
				warn("Executor does not support sending webhooks.")
				Status.set("webhook", "Waiting - your executor can't send webhooks")
				pcall(function()
					game:GetService("StarterGui"):SetCore("SendNotification", {
						Title = "Unsupported Executor", Text = "Your executor cannot send webhooks.", Duration = 5,
					})
				end)
				return
			end
			while live() do
				if webhookURL == "" then
					Status.set("webhook", "Waiting for a webhook URL (enter it on the Webhook tab)")
					task.wait(1)
				else
					Status.set("webhook", "Sending your stats...")
					local ok = sendStats()
					if not live() then break end
					local nextAt = os.clock() + SEND_EVERY
					while live() and webhookURL ~= "" and os.clock() < nextAt do
						Status.set("webhook", ok and "Waiting for the next report" or "Waiting - the last report failed, retrying",
							nextAt - os.clock())
						task.wait(1)
					end
				end
			end
		end)
	end

	local entries = {
		{
			type = "input", name = "Webhook URL", icon = "🔗", placeholder = "Discord webhook URL",
			desc = "Paste your Discord webhook link here. The stats are posted to it.",
			callback = function(value)
				webhookURL = (tostring(value or ""):gsub("^%s+", ""):gsub("%s+$", ""))
				if loggerToggle and loggerToggle._get and loggerToggle._get() then start() end   -- new URL: report again right away
			end,
		},
	}
	loggerToggle = {
		type = "toggle", name = "Enable Webhook Logger", icon = "📡", default = false,
		desc = "Sends your username, muscle, stage and cash to the webhook every 10 minutes.",
		callback = function(on)
			if on then start() else stop() end
		end,
	}
	entries[#entries + 1] = loggerToggle
	return entries
end)()
