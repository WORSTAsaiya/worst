-- Players dropdown (updates by itself when someone joins / leaves) + Teleport to Player + Auto Attack & Teleport + Spectate Player.
-- No extra windows: Spectate follows the player chosen in the dropdown.
TAB_SCRIPTS.Players = (function()
	local Status = FX.Status
	local VirtualUser = game:GetService("VirtualUser")

	local gens = {}
	local function newGen(key) gens[key] = (gens[key] or 0) + 1 return gens[key] end
	local function getRoot()
		local ch = player.Character
		return ch and ch:FindFirstChild("HumanoidRootPart")
	end
	local function getHum()
		local ch = player.Character
		return ch and ch:FindFirstChildOfClass("Humanoid")
	end

	-- ---------------------------------------------------------------- the Players dropdown
	local options = {}
	local chosen
	local playersEntry

	-- rebuilds the list (everyone except you); `leaving` = a player that is just about to leave
	local function refreshPlayers(leaving)
		local names = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p ~= leaving then names[#names + 1] = p.Name end
		end
		table.sort(names, function(a, b) return a:lower() < b:lower() end)
		table.clear(options)
		for _, n in ipairs(names) do options[#options + 1] = n end
		if not (chosen and table.find(options, chosen)) then chosen = options[1] end
		if playersEntry and playersEntry._refresh then playersEntry._refresh(chosen or "—") end
	end
	refreshPlayers()
	connect(Players.PlayerAdded, function() task.defer(refreshPlayers) end)
	connect(Players.PlayerRemoving, function(p) refreshPlayers(p) end)

	local function chosenPlayer() return chosen and Players:FindFirstChild(chosen) end

	-- ---------------------------------------------------------------- Auto Attack & Teleport (old "Player Hunt")
	local HEROIC_FAMES = {
		"Nice Guy", "Bodyguard", "Guardian", "Saint", "Angelic",
		"Vanquisher", "Savior", "The Watcher", "Keeper of Light",
		"Peacemaker", "Invulnerable", "Osiris", "Arch-angel",
		"Paladin", "Demigod", "Heavenly", "Emperor",
	}
	local NOTORIOUS_FAMES = {
		"Bully", "Jerk", "Thug", "Criminal", "Godfather",
		"Corrupted", "Hunter", "Tyrant", "Cursebearer", "Sinister",
		"Satan", "Bloodthirsty", "Arch-demon", "Asmodeus", "The Devil",
		"Undying", "Warlord", "Chaos King", "Berserker", "Nightmare",
	}
	local IMMUNITY_ZONES = {
		Vector3.new(-634.5390625, -53.9104830932617, 1859.409912109371),
		Vector3.new(-646.37, -53.64, 1784.42),
	}
	local IMMUNITY_RADIUS = 20
	local MAX_COMBAT_TIME = 8

	local function isInImmunityZone(p)
		local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end
		for _, zone in ipairs(IMMUNITY_ZONES) do
			if (hrp.Position - zone).Magnitude <= IMMUNITY_RADIUS then return true end
		end
		return false
	end
	local function getStage(p)
		local ls = p:FindFirstChild("leaderstats")
		local st = ls and ls:FindFirstChild("Stage")
		return st and st.Value or 0
	end
	local function getFaction(p)
		local head = p.Character and p.Character:FindFirstChild("Head")
		local tg = head and head:FindFirstChild("TitleGui")
		local fame = tg and tg:FindFirstChild("FameTxt")
		if not (fame and fame:IsA("TextLabel")) then return "Neutral" end
		local text = string.lower(fame.Text)
		for _, n in ipairs(HEROIC_FAMES) do
			if string.find(text, string.lower(n), 1, true) then return "Heroic" end
		end
		for _, n in ipairs(NOTORIOUS_FAMES) do
			if string.find(text, string.lower(n), 1, true) then return "Notorious" end
		end
		return "Neutral"
	end
	local function isValidTarget(myFaction, targetFaction)
		return (myFaction == "Heroic" and targetFaction == "Notorious")
			or (myFaction == "Notorious" and (targetFaction == "Heroic" or targetFaction == "Neutral"))
	end
	local function isAlive(p)
		local ch = p and p.Character
		if not ch then return false end
		local hum = ch:FindFirstChildOfClass("Humanoid")
		return hum ~= nil and ch:FindFirstChild("HumanoidRootPart") ~= nil and hum.Health > 0
	end

	local function huntLoop(my)
		while alive and gens.hunt == my do
			local myStage, myFaction = getStage(player), getFaction(player)
			local target
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= player and isAlive(p) and getStage(p) < myStage and not isInImmunityZone(p)
					and isValidTarget(myFaction, getFaction(p)) then
					target = p
					break
				end
			end
			if target then
				Status.set("hunt", "Attacking " .. target.Name .. " (stage " .. getStage(target) .. ")")
				local started = os.clock()
				while alive and gens.hunt == my and os.clock() - started < MAX_COMBAT_TIME and isAlive(target) do
					local tr = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
					local mine = getRoot()
					if tr and mine then mine.CFrame = tr.CFrame end
					pcall(function() VirtualUser:ClickButton1(Vector2.new(9e9, 9e9)) end)
					task.wait(0.05)
				end
				task.wait(0.5)
			else
				Status.set("hunt", "Waiting - no valid targets", 1)
				task.wait(1)
			end
		end
	end

	-- ---------------------------------------------------------------- Spectate Player
	local function restoreCamera()
		local cam, hum = workspace.CurrentCamera, getHum()
		if cam and hum and cam.CameraSubject ~= hum then cam.CameraSubject = hum end
	end

	playersEntry = {
		type = "dropdown", name = "Players", icon = "👥", width = 300, noSave = true,
		desc = "Everyone in the server. The list updates by itself when someone joins or leaves.",
		options = options,
		onOpen = function() refreshPlayers() end,
		callback = function(option)
			if option and table.find(options, option) then chosen = option end
		end,
	}

	return {
		playersEntry,
		{
			type = "button", name = "Teleport to Player", icon = "🚀", btnText = "Teleport", noSave = true,
			desc = "Teleports you to the player chosen above.",
			run = function()
				local target = chosenPlayer()
				local tr = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
				if not tr then error("Pick a player first (or wait for their character to load)") end
				local mine = getRoot()
				if not mine then error("Your character isn't loaded") end
				mine.CFrame = CFrame.new(tr.Position)
				return true
			end,
		},
		{
			type = "toggle", name = "Auto Attack & Teleport", icon = "⚔", default = false,
			desc = "Hunts players of the opposite team whose stage is lower than yours. Make sure to equip Fist/Foot.",
			callback = function(on)
				local my = newGen("hunt")
				if not on then Status.set("hunt", nil) return end
				task.spawn(huntLoop, my)
			end,
		},
		{
			type = "toggle", name = "Spectate Player", icon = "👁", default = false,
			desc = "Spectates the player chosen above. Turn it off to get your own camera back.",
			callback = function(on)
				local my = newGen("spec")
				if not on then
					Status.set("spec", nil)
					restoreCamera()
					return
				end
				task.spawn(function()
					while alive and gens.spec == my do
						local target = chosenPlayer()
						local hum = target and target.Character and target.Character:FindFirstChildOfClass("Humanoid")
						local cam = workspace.CurrentCamera
						if hum and cam then
							if cam.CameraSubject ~= hum then cam.CameraSubject = hum end
							Status.set("spec", "Spectating " .. target.Name)
						else
							Status.set("spec", "Waiting - chosen player isn't available")
							restoreCamera()   -- never leave you stuck on a camera that has nothing to look at
						end
						task.wait(0.2)
					end
				end)
			end,
		},
	}
end)()

